# Secrets for the Edge Functions on the local stack. Copy to `.env` (gitignored)
# and fill in; `npx supabase start` loads it (restart the stack after editing).
# Locally the functions upload to the dev bucket: never put production keys here.
# The cloud project gets its own values with `npx supabase secrets set`.
#
# Supabase injects its own URL and secret key into every function, so they
# aren't listed here (names starting with SUPABASE_ are reserved anyway).

# Cloudflare account id (R2 → Overview → Account details)
R2_ACCOUNT_ID=
# An R2 API token with Object Read & Write on R2_BUCKET only
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=stylper-images-dev
# Where the bucket's objects are public, no trailing slash: the dev bucket's
# r2.dev URL; https://img.stylper.app in production
IMG_PUBLIC_BASE=
